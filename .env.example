# Локальні налаштування. Скопіюйте цей файл у .env та створіть власний ключ.
SECRET_KEY=replace-with-your-own-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
HTTPS_ENABLED=False

# Локально листи виводяться в термінал. SMTP вмикайте на сервері після налаштування пошти.
MAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="Роздільнянський ковбасний цех <sender@example.com>"
MANAGER_EMAIL=manager@example.com

# Приклад SMTP для Gmail. Потрібен окремий пароль додатка Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=15
